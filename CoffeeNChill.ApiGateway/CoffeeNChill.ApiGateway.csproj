    <ImplicitUsings>enable</ImplicitUsings>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn>
	<UserSecretsId>2620fb33-06d4-4aaa-b4f7-1e391064cdf6</UserSecretsId>  
